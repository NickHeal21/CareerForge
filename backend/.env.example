# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/careerforge

# JWT
SECRET_KEY=your-very-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# RapidAPI JSearch (optional; external jobs are disabled when unset)
JSEARCH_API_KEY=

# App
# Supported values: development (local initialization enabled), production, prod.
APP_ENV=development
# Comma-separated exact origins. Production requires valid HTTPS origins only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
